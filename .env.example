# Supabase Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# For local development, copy this file to .env
# For Vercel deployment, add these to Environment Variables in Vercel dashboard

# Frontend variables (must start with VITE_ for Vite)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend variable (for server.js - document uploads)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Anthropic key used for quote extraction and the AI helpers.
# Set this to have the operator pay for all users. If it is unset, each user's
# own key (saved in Settings) is used instead. Either way the key is only ever
# read server-side - it is never sent to the browser.
ANTHROPIC_API_KEY=

# Optional: override the extraction/AI model
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Comma-separated list of browser origins allowed to call the API.
# Same-origin requests (the normal Vercel deployment) are always allowed;
# localhost dev origins are added automatically when NODE_ENV != production.
# ALLOWED_ORIGINS=https://your-app.vercel.app

# Optional: Set to 'production' in Vercel
NODE_ENV=development
