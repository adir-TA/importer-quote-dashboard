# Supabase Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# For local development, copy this file to .env
# For Vercel deployment, add these to Environment Variables in Vercel dashboard

# Frontend variables (must start with VITE_ for Vite)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend variable (for server.js - document uploads)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: Set to 'production' in Vercel
NODE_ENV=development

# Demo Mode - Skip authentication for testing (set to 'true' to enable)
# When enabled, app will auto-login as a demo user without requiring credentials
# Set to 'false' or remove to re-enable normal authentication
VITE_DEMO_MODE=false
