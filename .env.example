# Supabase Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# For local development, copy this file to .env
# For Vercel deployment, add these to Environment Variables in Vercel dashboard

# Frontend variables (must start with VITE_ for Vite)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend variable (for server.js - document uploads)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: Set to 'production' in Vercel
NODE_ENV=development

# NOTE: Demo mode is now controlled in src/context/AuthContext.jsx (line 11)
# No environment variable needed - just edit DEMO_MODE constant in the code
